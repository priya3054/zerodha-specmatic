{
  "http-request": {
    "method": "POST",
    "path": "/newOrder",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "name": "HDFC",
      "qty": 10,
      "price": 1600.50,
      "mode": "BUY"
    }
  },
  "http-response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "message": "$match(exact:HDFC order added to portfolio)"
    }
  }
}
