{
  "http-request": {
    "method": "POST",
    "path": "/auth/login",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "username": "(USERNAME:string)",
      "password": "(PASSWORD:string)"
    }
  },
  "http-response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "user": {
        "_id": "$(dataLookup.users[USERNAME]._id)",
        "username": "$(USERNAME)",
        "email": "$(dataLookup.users[USERNAME].email)",
        "balance": 0
      }
    }
  },
  "dataLookup": {
    "users": {
      "testuser1": { "_id": "64abc123def456", "email": "testuser1@gmail.com" },
      "newtrader":  { "_id": "64abc789ghi012", "email": "newtrader@gmail.com" },
      "priya123":   { "_id": "64def456jkl789", "email": "priya300504@gmail.com" }
    }
  }
}
